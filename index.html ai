<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Copast - Asisten Promosi UMKM</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --primary: #6366f1;
            --text-color: #f8fafc;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            width: 100%;
            max-width: 600px;
            background: var(--card-bg);
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }
        h1 { text-align: center; color: #818cf8; margin-bottom: 10px; }
        p.subtitle { text-align: center; color: #94a3b8; margin-bottom: 30px; }
        .form-group { margin-bottom: 20px; }
        label { display: block; margin-bottom: 8px; font-weight: 600; }
        input, select {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #334155;
            background: #0f172a;
            color: white;
            box-sizing: border-box;
        }
        button {
            width: 100%;
            padding: 12px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }
        button:hover { background: #4f46e5; }
        .result-box {
            margin-top: 25px;
            padding: 15px;
            background: #0f172a;
            border-left: 4px solid var(--primary);
            border-radius: 4px;
            white-space: pre-wrap;
            display: none;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>AI Copast Studio</h1>
        <p class="subtitle">Buat caption jualan otomatis dalam hitungan detik.</p>
        
        <div class="form-group">
            <label for="productName">Nama Produk / Jasa:</label>
            <input type="text" id="productName" placeholder="Contoh: Es Teh Manis Jumbo">
        </div>
        
        <div class="form-group">
            <label for="tone">Gaya Bahasa:</label>
            <select id="tone">
                <option value="semangat">Bersemangat & Persuasif</option>
                <option value="lucu">Humoris / Gen Z</option>
                <option value="formal">Profesional / Elegan</option>
            </select>
        </div>

        <button onclick="generateAI()">Generate Caption AI 🚀</button>

        <div id="result" class="result-box"></div>
    </div>

    <script>
        function generateAI() {
            const product = document.getElementById('productName').value;
            const tone = document.getElementById('tone').value;
            const resultBox = document.getElementById('result');

            if (!product) {
                alert('Mohon masukkan nama produk terlebih dahulu!');
                return;
            }

            // Simulasi kecerdasan buatan (AI Response Logic)
            let caption = "";
            if (tone === 'semangat') {
                caption = `🔥 PANAS-PANAS GINI ENAKNYA MINUM APA? Yuk segarkan hari mu dengan ${product}! Dijamin langsung bikin semangat lagi. Stok terbatas, buruan order sekarang sebelum kehabisan! ✨🛒`;
            } else if (tone === 'lucu') {
                caption = `Dompet boleh tipis, tapi tenggorokan harus tetap estetik! 🥤✨ Nikmati ${product} penyelamat hari seninmu. Dijamin bikin senyum-senyum sendiri. Cuss klik link di bio!`;
            } else {
                caption = `Persembahan terbaik untuk Anda, ${product}. Dibuat dengan standar kualitas tinggi untuk menemani produktivitas harian Anda. Silakan hubungi kami untuk pemesanan lebih lanjut.`;
            }

            resultBox.style.display = 'block';
            resultBox.innerHTML = `<strong>Hasil AI:</strong><br><br>${caption}`;
        }
    </script>

</body>
</html>
